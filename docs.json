{
  "theme": "luma",
  "name": "Blockli",
  "description": "Documentation for the Blockli platform — WordPress plugin, Studio Cloud, and SDK for building and publishing white-label mobile community apps.",
  "colors": {
    "primary": "#6366f1",
    "light": "#6366f1",
    "dark": "#6366f1"
  },
  "logo": {
    "light": "/images/logo_black.png",
    "dark": "/images/logo_white.png",
    "href": "https://blockli.app"
  },
  "favicon": "https://blockli.app/icons/Logo%20/logo_black.png",
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Studio",
      "href": "https://blockli-studio-cloud.onrender.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "app-changelog"
            ]
          },
          {
            "group": "WordPress Plugin",
            "pages": [
              "plugin/installation",
              "plugin/settings",
              "plugin/studio-connection",
              "plugin/typography",
              "plugin/push-notifications",
              "plugin/authentication",
              "plugin/in-app-purchases",
              "plugin/iap-google-cloud",
              "plugin/iap-ios",
              "plugin/iap-google-products",
              "plugin/iap-stripe",
              "plugin/app-pages",
              "plugin/custom-post-types"
            ]
          },
          {
            "group": "Studio Cloud",
            "pages": [
              "studio/setup-checklist",
              "studio/overview",
              "studio/create-app",
              "studio/wordpress-connection",
              "studio/app-configuration",
              "studio/credentials-ios",
              "studio/app-links",
              "studio/credentials-android",
              "studio/google-signin-android",
              "studio/google-signin-ios",
              "studio/apple-signin",
              "studio/eas-build",
              "studio/on-air-releases",
              "studio/store-submission"
            ]
          },
          {
            "group": "Changelog",
            "pages": [
              "changelog/plugin-changelog",
              "changelog/app-changelog"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/changelog",
      "destination": "/changelog/plugin-changelog",
      "permanent": true
    },
    {
      "source": "/app-changelog",
      "destination": "/changelog/app-changelog",
      "permanent": true
    }
  ]
}
